{
  "name": "trace-security-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "benchmark:source": "node --import tsx scripts/benchmark-source.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node scripts/start.mjs",
    "api": "node --import tsx src/server/main.ts",
    "worker": "node --import tsx src/server/worker-main.ts",
    "mcp": "node --import tsx src/mcp.ts",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:scanner": "tsx --test tests/scanner.integration.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint src tests scripts vite.config.ts",
    "format": "prettier --write src tests scripts rules vite.config.ts",
    "format:check": "prettier --check src tests scripts rules vite.config.ts",
    "test:mcp": "tsx --test tests/mcp.integration.ts",
    "test:recovery": "tsx --test tests/recovery.integration.ts",
    "test:live": "tsx --test tests/live.integration.ts",
    "test:resources": "tsx --test tests/resources.integration.ts",
    "start:local": "node scripts/start-local.mjs",
    "start:api": "powershell -NoProfile -File scripts/start-api.ps1",
    "ai:usage": "node --import tsx src/server/api-usage-main.ts",
    "db:migrate": "node --import tsx src/server/db/migrate-main.ts",
    "db:generate": "drizzle-kit generate",
    "test:postgres": "tsx --test tests/postgres.integration.ts",
    "test:local-ai": "tsx --test tests/local-agent.integration.ts",
    "test:api-ai": "tsx --test tests/api-agent.integration.ts",
    "db:import-legacy": "tsx scripts/import-legacy-sqlite.ts",
    "db:up": "node scripts/database-up.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.0"
  },
  "overrides": {
    "minimatch": "^11.0.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
